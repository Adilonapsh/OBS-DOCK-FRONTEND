                    <span style={{ width: 14, height: 14, borderRadius: '50%', background: '#ea580c' }} />
                    <div style={{ flex: 1, display: 'flex', flexDirection: 'column', gap: 4 }}>
                      <span style={{ width: '70%', height: 5, background: '#fdba74', borderRadius: 2 }} />
