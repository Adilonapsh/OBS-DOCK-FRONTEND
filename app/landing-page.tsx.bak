export default function LandingPage() {
  /* Auth State */
  const [isLoggedIn, setIsLoggedIn] = useState(false);
  useEffect(() => {
    const supabase = createClient();
    supabase.auth.getUser().then(({ data: { user } }) => setIsLoggedIn(!!user));
    const { data: { subscription } } = supabase.auth.onAuthStateChange((_e, s) => setIsLoggedIn(!!s));
    return () => subscription.unsubscribe();
  }, []);

  /* Navbar Dropdown State */
  const [openDropdown, setOpenDropdown] = useState<'fitur' | 'widget' | null>(null);
  const fiturRef = useRef<HTMLDivElement>(null);
  const widgetRef = useRef<HTMLDivElement>(null);
  useEffect(() => {
    const handleClickOutside = (e: MouseEvent) => {
      const t = e.target as Node;
      const insideFitur = fiturRef.current?.contains(t);
      const insideWidget = widgetRef.current?.contains(t);
      if (!insideFitur && !insideWidget) setOpenDropdown(null);
    };
    const handleEsc = (e: KeyboardEvent) => {
      if (e.key === 'Escape') setOpenDropdown(null);
    };
    document.addEventListener('mousedown', handleClickOutside);
    document.addEventListener('keydown', handleEsc);
    return () => {
      document.removeEventListener('mousedown', handleClickOutside);
      document.removeEventListener('keydown', handleEsc);
    };
  }, []);

  /* Mobile Menu State */
  const [mobileOpen, setMobileOpen] = useState(false);
  const [mobileDropdown, setMobileDropdown] = useState<'fitur' | 'widget' | null>(null);
  useEffect(() => {
    if (mobileOpen) {
      document.body.style.overflow = 'hidden';
    } else {
      document.body.style.overflow = '';
      setMobileDropdown(null);
    }
    return () => { document.body.style.overflow = ''; };
  }, [mobileOpen]);
  useEffect(() => {
    const onResize = () => {
      if (window.innerWidth > 1024 && mobileOpen) setMobileOpen(false);
    };
    window.addEventListener('resize', onResize);
    return () => window.removeEventListener('resize', onResize);
  }, [mobileOpen]);

  /* Toast Notification */
  const [toastText, setToastText] = useState('');
  const toastTimeoutRef = useRef<number | null>(null);
  const showToast = (msg: string) => {
    setToastText(msg);
    if (toastTimeoutRef.current) window.clearTimeout(toastTimeoutRef.current);
    toastTimeoutRef.current = window.setTimeout(() => setToastText(''), 2600);
  };


  /* Platform filter state */
  const [activePlatform, setActivePlatform] = useState('obs');

  /* Aesthetic tab filter */
  const [activeAestheticTab, setActiveAestheticTab] = useState<'product' | 'game' | 'aesthetic'>('product');

  /* FAQ accordion */
  const [openFaq, setOpenFaq] = useState<number | null>(null);
  const toggleFaq = (i: number) => setOpenFaq(prev => prev === i ? null : i);

  return (
    <div className="kudos-page">
      {/* ====================================================================
         NAVBAR (Exact match to Kudos.tv screenshot)
         ==================================================================== */}
      <header className="kudos-header">
        <div className="kudos-header-inner">
          <Link href="/" className="kudos-logo">
            OBS Dock
          </Link>

          <nav className="kudos-nav-links">
            <Link href="/" className="kudos-nav-item active">
              Home
            </Link>
            {/* Fitur Dropdown */}
            <div
              className="kudos-nav-dropdown-wrap"
              ref={fiturRef}
              onMouseEnter={() => setOpenDropdown('fitur')}
              onMouseLeave={() => setOpenDropdown(null)}
            >
              <button
                className={`kudos-nav-item kudos-nav-dropdown-trigger ${openDropdown === 'fitur' ? 'open' : ''}`}
                onClick={() => setOpenDropdown(prev => (prev === 'fitur' ? null : 'fitur'))}
                aria-expanded={openDropdown === 'fitur'}
                aria-haspopup="true"
              >
                Fitur <ChevronDown className="chevron" size={14} style={{ transform: openDropdown === 'fitur' ? 'rotate(180deg)' : undefined, transition: 'transform 0.2s ease' }} />
              </button>
              <div className={`kudos-dropdown ${openDropdown === 'fitur' ? 'open' : ''}`}>
                <div className="kudos-dropdown-grid">
                  <a href="#inside" onClick={() => setOpenDropdown(null)} className="kudos-dropdown-item">
                    <span className="kudos-dropdown-icon" style={{ background: '#e0f2fe', borderColor: '#bae6fd' }}><Monitor size={16} color="#0284c7" /></span>
                    <span className="kudos-dropdown-text"><strong>Dock Control</strong><span>Studio Mode & Scene Switcher</span></span>
                  </a>
                  <a href="#inside" onClick={() => setOpenDropdown(null)} className="kudos-dropdown-item">
                    <span className="kudos-dropdown-icon" style={{ background: '#ffedd5', borderColor: '#fed7aa' }}><Layers size={16} color="#ea580c" /></span>
                    <span className="kudos-dropdown-text"><strong>Event Overlay</strong><span>Gift, Follow & Donasi Real-time</span></span>
                  </a>
                  <a href="#inside" onClick={() => setOpenDropdown(null)} className="kudos-dropdown-item">
                    <span className="kudos-dropdown-icon" style={{ background: '#ede9fe', borderColor: '#ddd6fe' }}><Headphones size={16} color="#7c3aed" /></span>
                    <span className="kudos-dropdown-text"><strong>Media Player</strong><span>11 Tema + Lirik LRCLIB</span></span>
                  </a>
                  <a href="#inside" onClick={() => setOpenDropdown(null)} className="kudos-dropdown-item">
                    <span className="kudos-dropdown-icon" style={{ background: '#e0e7ff', borderColor: '#c7d2fe' }}><Smartphone size={16} color="#4f46e5" /></span>
                    <span className="kudos-dropdown-text"><strong>Mobile Dock</strong><span>Kontrol OBS dari HP</span></span>
                  </a>
                  <a href="#inside" onClick={() => setOpenDropdown(null)} className="kudos-dropdown-item">
                    <span className="kudos-dropdown-icon" style={{ background: '#dcfce7', borderColor: '#bbf7d0' }}><Radio size={16} color="#16a34a" /></span>
                    <span className="kudos-dropdown-text"><strong>Private WebSocket</strong><span>Room isolasi per streamer</span></span>
                  </a>
                  <a href="#inside" onClick={() => setOpenDropdown(null)} className="kudos-dropdown-item">
                    <span className="kudos-dropdown-icon" style={{ background: '#f1f5f9', borderColor: '#e2e8f0' }}><Sliders size={16} color="#334155" /></span>
                    <span className="kudos-dropdown-text"><strong>Widget Dashboard</strong><span>Kelola semua widget terpusat</span></span>
                  </a>
                </div>
                <a href="#inside" onClick={() => setOpenDropdown(null)} className="kudos-dropdown-footer">
                  Lihat semua fitur <ArrowRight size={13} />
                </a>
              </div>
            </div>

            {/* Widget Dropdown */}
            <div
              className="kudos-nav-dropdown-wrap"
              ref={widgetRef}
              onMouseEnter={() => setOpenDropdown('widget')}
              onMouseLeave={() => setOpenDropdown(null)}
            >
              <button
                className={`kudos-nav-item kudos-nav-dropdown-trigger ${openDropdown === 'widget' ? 'open' : ''}`}
                onClick={() => setOpenDropdown(prev => (prev === 'widget' ? null : 'widget'))}
                aria-expanded={openDropdown === 'widget'}
                aria-haspopup="true"
              >
                Widget <ChevronDown className="chevron" size={14} style={{ transform: openDropdown === 'widget' ? 'rotate(180deg)' : undefined, transition: 'transform 0.2s ease' }} />
              </button>
              <div className={`kudos-dropdown kudos-dropdown--widget ${openDropdown === 'widget' ? 'open' : ''}`}>
                <div className="kudos-dropdown-grid">
                  <a href="#aesthetic" onClick={() => setOpenDropdown(null)} className="kudos-dropdown-item">
                    <span className="kudos-dropdown-icon" style={{ background: '#e0f2fe', borderColor: '#bae6fd' }}><MessageSquare size={16} color="#0284c7" /></span>
                    <span className="kudos-dropdown-text"><strong>Chat Widget</strong><span>Twitch, YouTube, TikTok Live</span></span>
                  </a>
                  <a href="#aesthetic" onClick={() => setOpenDropdown(null)} className="kudos-dropdown-item">
                    <span className="kudos-dropdown-icon" style={{ background: '#d1fae5', borderColor: '#a7f3d0' }}><BarChart3 size={16} color="#059669" /></span>
                    <span className="kudos-dropdown-text"><strong>Poll & Goals</strong><span>Vote interaktif & target donasi</span></span>
                  </a>
                  <a href="#aesthetic" onClick={() => setOpenDropdown(null)} className="kudos-dropdown-item">
                    <span className="kudos-dropdown-icon" style={{ background: '#ffedd5', borderColor: '#fed7aa' }}><Gift size={16} color="#ea580c" /></span>
                    <span className="kudos-dropdown-text"><strong>Overlays</strong><span>Chat, Gift, Like, Full Overlay</span></span>
                  </a>
                  <a href="#aesthetic" onClick={() => setOpenDropdown(null)} className="kudos-dropdown-item">
                    <span className="kudos-dropdown-icon" style={{ background: '#ede9fe', borderColor: '#ddd6fe' }}><Music2 size={16} color="#7c3aed" /></span>
                    <span className="kudos-dropdown-text"><strong>Media & Lirik</strong><span>Sync lirik otomatis</span></span>
                  </a>
                  <a href="#aesthetic" onClick={() => setOpenDropdown(null)} className="kudos-dropdown-item">
                    <span className="kudos-dropdown-icon" style={{ background: '#fef9c3', borderColor: '#fde68a' }}><Puzzle size={16} color="#a16207" /></span>
                    <span className="kudos-dropdown-text"><strong>Utility Widgets</strong><span>Timer, Ticker, QR, Counter</span></span>
                  </a>
                  <a href="#aesthetic" onClick={() => setOpenDropdown(null)} className="kudos-dropdown-item">
                    <span className="kudos-dropdown-icon" style={{ background: '#cffafe', borderColor: '#a5f3fc' }}><Volume2 size={16} color="#0891b2" /></span>
                    <span className="kudos-dropdown-text"><strong>Social Rotator</strong><span>Info Slides & sosmed</span></span>
                  </a>
                </div>
                <a href="#aesthetic" onClick={() => setOpenDropdown(null)} className="kudos-dropdown-footer">
                  Jelajahi semua widget <ArrowRight size={13} />
                </a>
              </div>
            </div>

            <a href="#reviews" className="kudos-nav-item">
              Testimoni
            </a>
            <a href="#faq" className="kudos-nav-item">
              FAQ
            </a>
            <a href="#spotlight" className="kudos-nav-item">
              Komunitas
            </a>
          </nav>

          <div className="kudos-nav-right">
            <Link
              href={isLoggedIn ? '/dashboard' : '/login'}
              className="kudos-user-btn"
              title={isLoggedIn ? 'Dashboard' : 'Login'}
            >
              <User size={19} />
            </Link>

            <Link
              href={isLoggedIn ? '/dashboard' : '/register'}
              className="kudos-cart-pill"
            >
              <Tv size={15} />
              <span>{isLoggedIn ? 'Dashboard' : 'Mulai Gratis'}</span>
            </Link>

            {/* Hamburger - Mobile Only */}
            <button
              className="kudos-hamburger"
              onClick={() => setMobileOpen(prev => !prev)}
              aria-label={mobileOpen ? 'Tutup menu' : 'Buka menu'}
              aria-expanded={mobileOpen}
            >
              {mobileOpen ? <XIcon size={20} /> : <Menu size={20} />}
            </button>
          </div>
        </div>

        {/* Mobile Drawer */}
        <div className={`kudos-mobile-overlay ${mobileOpen ? 'open' : ''}`} onClick={() => setMobileOpen(false)} aria-hidden="true" />
        <nav className={`kudos-mobile-menu ${mobileOpen ? 'open' : ''}`} aria-hidden={!mobileOpen}>
          <Link href="/" className="kudos-mobile-link" onClick={() => setMobileOpen(false)}>Home</Link>

          {/* Fitur Accordion */}
          <div className="kudos-mobile-accordion">
            <button
              className={`kudos-mobile-link kudos-mobile-trigger ${mobileDropdown === 'fitur' ? 'open' : ''}`}
              onClick={() => setMobileDropdown(prev => (prev === 'fitur' ? null : 'fitur'))}
              aria-expanded={mobileDropdown === 'fitur'}
            >
              <span>Fitur</span>
              <ChevronDown size={16} className="kudos-mobile-chevron" style={{ transform: mobileDropdown === 'fitur' ? 'rotate(180deg)' : undefined }} />
            </button>
            <div className={`kudos-mobile-dropdown ${mobileDropdown === 'fitur' ? 'open' : ''}`}>
              <a href="#inside" onClick={() => setMobileOpen(false)} className="kudos-mobile-dropdown-item">
                <span className="kudos-dropdown-icon" style={{ background: '#e0f2fe', borderColor: '#bae6fd' }}><Monitor size={16} color="#0284c7" /></span>
                <span><strong>Dock Control</strong><span>Studio Mode & Scene Switcher</span></span>
              </a>
              <a href="#inside" onClick={() => setMobileOpen(false)} className="kudos-mobile-dropdown-item">
