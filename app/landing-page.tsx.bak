            </div>
          </div>

          {/* Widget Accordion */}
          <div className="kudos-mobile-accordion">
            <button
              className={`kudos-mobile-link kudos-mobile-trigger ${mobileDropdown === 'widget' ? 'open' : ''}`}
              onClick={() => setMobileDropdown(prev => (prev === 'widget' ? null : 'widget'))}
              aria-expanded={mobileDropdown === 'widget'}
            >
              <span>Widget</span>
              <ChevronDown size={16} className="kudos-mobile-chevron" style={{ transform: mobileDropdown === 'widget' ? 'rotate(180deg)' : undefined }} />
            </button>
            <div className={`kudos-mobile-dropdown ${mobileDropdown === 'widget' ? 'open' : ''}`}>
              <a href="#aesthetic" onClick={() => setMobileOpen(false)} className="kudos-mobile-dropdown-item">
                <span className="kudos-dropdown-icon" style={{ background: '#e0f2fe', borderColor: '#bae6fd' }}><MessageSquare size={16} color="#0284c7" /></span>
                <span><strong>Chat Widget</strong><span>Twitch, YouTube, TikTok</span></span>
              </a>
              <a href="#aesthetic" onClick={() => setMobileOpen(false)} className="kudos-mobile-dropdown-item">
                <span className="kudos-dropdown-icon" style={{ background: '#d1fae5', borderColor: '#a7f3d0' }}><BarChart3 size={16} color="#059669" /></span>
                <span><strong>Poll & Goals</strong><span>Vote & target donasi</span></span>
              </a>
              <a href="#aesthetic" onClick={() => setMobileOpen(false)} className="kudos-mobile-dropdown-item">
                <span className="kudos-dropdown-icon" style={{ background: '#ffedd5', borderColor: '#fed7aa' }}><Gift size={16} color="#ea580c" /></span>
                <span><strong>Overlays</strong><span>Chat, Gift, Full Overlay</span></span>
              </a>
              <a href="#aesthetic" onClick={() => setMobileOpen(false)} className="kudos-mobile-dropdown-item">
                <span className="kudos-dropdown-icon" style={{ background: '#ede9fe', borderColor: '#ddd6fe' }}><Music2 size={16} color="#7c3aed" /></span>
                <span><strong>Media & Lirik</strong><span>Sync lirik otomatis</span></span>
              </a>
              <a href="#aesthetic" onClick={() => setMobileOpen(false)} className="kudos-mobile-dropdown-item">
                <span className="kudos-dropdown-icon" style={{ background: '#fef9c3', borderColor: '#fde68a' }}><Puzzle size={16} color="#a16207" /></span>
                <span><strong>Utility Widgets</strong><span>Timer, Ticker, QR</span></span>
              </a>
              <a href="#aesthetic" onClick={() => setMobileOpen(false)} className="kudos-mobile-dropdown-item">
                <span className="kudos-dropdown-icon" style={{ background: '#cffafe', borderColor: '#a5f3fc' }}><Volume2 size={16} color="#0891b2" /></span>
