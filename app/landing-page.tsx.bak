                  <div style={{ width: '85%', height: 46, background: '#ffffff', borderRadius: 12, border: '1px solid #fed7aa', display: 'flex', alignItems: 'center', gap: 10, padding: '0 14px', boxShadow: '0 6px 16px rgba(249, 115, 22, 0.08)' }}>
