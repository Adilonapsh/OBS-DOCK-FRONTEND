          <a href="#faq" className="kudos-mobile-link" onClick={() => setMobileOpen(false)}>FAQ</a>
          <a href="#spotlight" className="kudos-mobile-link" onClick={() => setMobileOpen(false)}>Komunitas</a>

          <div className="kudos-mobile-cta">
            <Link href={isLoggedIn ? '/dashboard' : '/register'} className="kudos-mobile-cta-btn" onClick={() => setMobileOpen(false)}>
              <Tv size={16} /> {isLoggedIn ? 'Buka Dashboard' : 'Mulai Gratis'}
            </Link>
          </div>
