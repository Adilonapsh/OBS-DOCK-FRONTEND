      </header>

      <main>
        {/* ====================================================================
           OBS DOCK CENTERED H-SCREEN HERO SECTION
           ==================================================================== */}
        <section className="obs-hero-hscreen">
          <div className="wrap">
            <div className="obs-hero-inner">
              {/* Top Badge */}
              <div className="obs-hero-badge">
                <span className="obs-pulse-dot" />
                <span>OBS Studio v28+ & WebSocket Privat Siap Pakai</span>
              </div>

              {/* Headline */}
              <h1 className="obs-hero-title">
                Kontrol OBS & 14+ Widget Stream<br />
                <span className="obs-hero-highlight">Langsung dari Browser</span>
              </h1>

              {/* Subtitle */}
              <p className="obs-hero-desc">
                Ganti scene Studio Mode, kontrol audio, pasang overlay chat & event donasi real-time, serta jalankan widget interaktif tanpa software rumit. Terhubung otomatis via Browser Source dan WebSocket room privat.
              </p>

              {/* Action Buttons */}
              <div className="obs-hero-buttons">
                <Link
                  href={isLoggedIn ? '/dashboard' : '/register'}
                  className="obs-btn-primary"
                >
                  {isLoggedIn ? 'Buka Dashboard' : 'Mulai Sekarang - Gratis'} <ArrowRight size={16} />
                </Link>
                <a href="#inside" className="obs-btn-secondary">
                  <Sliders size={16} /> Jelajahi Fitur
                </a>
              </div>

              {/* Trust & Proof Row */}
              <div className="obs-hero-trust">
                <span className="obs-hero-stars">★★★★★</span>
                <span className="obs-hero-trust-bold">500+ streamer aktif</span>
                <span>·</span>
                <span>Tanpa kartu kredit</span>
                <span>·</span>
                <span>Setup instan 60 detik</span>
              </div>

              {/* OBS Dock Live Controller Screenshot Frame (/dock) */}
              <div className="obs-dock-preview-frame">
                {/* Topbar */}
                <div className="obs-dock-preview-topbar">
                  <div className="obs-dock-topbar-left">
                    <div className="obs-dock-dots">
                      <span className="obs-dock-dot red" />
                      <span className="obs-dock-dot yellow" />
                      <span className="obs-dock-dot green" />
                    </div>
                    <span className="obs-dock-title-tag">OBS_DOCK // app.obsdock.com/dock</span>
                  </div>
                  <div className="obs-dock-topbar-right">
                    <span className="obs-dock-rec-pill">● OBS STUDIO READY</span>
                    <span className="obs-dock-key-pill">ROOM: #usr_private</span>
                  </div>
                </div>

                {/* Screenshot of /dock */}
                <div className="obs-dock-screenshot-container">
                  <img
                    src="/assets/dock-preview.png"
                    alt="OBS Dock Controller Interface (/dock)"
                    className="obs-dock-screenshot-img"
                  />
                </div>
              </div>
            </div>
          </div>
        </section>

        {/* ====================================================================
           "STREAM OVERLAYS FOR EVERY PLATFORM"
           ==================================================================== */}
        <section id="platforms" className="kudos-every-platform-section">
          <div className="wrap">
            <h2 className="kudos-platform-heading">
              <span>Stream Overlays</span>
              <span>for</span>
              <span className="kudos-platform-pill-badge">Every Platform</span>
            </h2>

            <div className="kudos-platform-list">
              {PLATFORMS.map((p) => (
                <button
                  key={p.id}
                  className={`kudos-platform-tag-btn ${activePlatform === p.id ? 'active' : ''}`}
                  onClick={() => {
                    setActivePlatform(p.id);
                    showToast(`Platform dipilih: ${p.name}`);
                  }}
                >
                  <img src={p.icon} alt={p.name} />
                  <span>{p.name}</span>
                </button>
              ))}
            </div>
          </div>
        </section>

        {/* ====================================================================
           SECTION 1: "INSIDE A STREAM PACK" (Exact match to Screenshots 1 & 2)
           ==================================================================== */}
        <section id="inside" className="kudos-inside-section">
