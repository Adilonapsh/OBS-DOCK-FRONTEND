                </div>
              </div>
              <Link href={isLoggedIn ? "/dashboard" : "/login"} className="kudos-btn-dark-pill">
                Coba OBS Dock Gratis <ArrowRight size={15} />
              </Link>
            </div>
          </div>
        </section>

        {/* ====================================================================
           SECTION 4: "BUY ONCE. NO SUBSCRIPTION." (Exact match to Screenshot 5)
           ==================================================================== */}
        <section id="buyonce" className="kudos-buyonce-section">
          <div className="wrap">
            <div className="kudos-buyonce-card">
              {/* Left Typography Column */}
              <div className="kudos-buyonce-left">
                <h2 className="kudos-buyonce-heading">
                  Mulai gratis.<br />
                  <span className="kudos-lime-pill">Tanpa biaya langganan.</span>
                </h2>
              </div>

              {/* Right Benefits Grid */}
              <div className="kudos-buyonce-grid">
                <div>
                  <h3 className="kudos-buyonce-item-title">Langsung aktif tanpa kartu kredit</h3>
                  <p className="kudos-buyonce-item-desc">
                    Cukup daftar akun dan Private Key unik kamu langsung aktif otomatis. Siap digunakan detik itu juga tanpa masa trial yang mengunci fitur.
                  </p>
                </div>

                <div>
                  <h3 className="kudos-buyonce-item-title">Atur tampilan sesuai gayamu</h3>
                  <p className="kudos-buyonce-item-desc">
                    Semua widget dan overlay dapat dikustomisasi: font, warna solid, tata letak, animasi kemunculan, hingga suara notifikasi event.
                  </p>
                </div>

                <div>
                  <h3 className="kudos-buyonce-item-title">Ringan dan terisolasi privat</h3>
                  <p className="kudos-buyonce-item-desc">
                    Komunikasi WebSocket private room memastikan performa OBS tetap ringan tanpa lag CPU, dan aman dari campur tangan stream lain.
                  </p>
                </div>

                <div>
                  <h3 className="kudos-buyonce-item-title">Bantuan dan panduan lengkap</h3>
                  <p className="kudos-buyonce-item-desc">
                    Tersedia panduan setup langkah demi langkah, dokumentasi browser source OBS, serta komunitas dan live chat yang siap membantu.
                  </p>
                </div>
              </div>
            </div>
          </div>
        </section>

        {/* ====================================================================
           SECTION 5: "COMMUNITY SPOTLIGHT"
           ==================================================================== */}
        <section id="spotlight" className="kudos-community-section">
          <div className="wrap">
            <h2 className="kudos-community-heading">
              <span>Community</span>
              <span className="kudos-spotlight-pill">spotlight</span>
            </h2>
            <p className="kudos-community-subhead">
              Lihat para streamer dan konten kreator yang telah mempercayakan live stream mereka dengan OBS Dock.
            </p>

            <div className="kudos-creator-grid">
              {CREATORS.map((c, i) => (
                <div key={i} className="kudos-creator-card">
                  <img src={c.img} alt={c.name} className="kudos-creator-img" />
                  <div className="kudos-creator-body">
                    <h3 className="kudos-creator-name">{c.name}</h3>
                    <p className="kudos-creator-desc">{c.role}</p>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </section>

        {/* ====================================================================
           SECTION 6: FAQ - Frequently Asked Questions
           ==================================================================== */}
        <section id="faq" className="kudos-faq-section">
          <div className="wrap">
            <div className="kudos-faq-layout">
              {/* Left sticky heading */}
              <div className="kudos-faq-heading-col">
                <h2 className="kudos-faq-title">Pertanyaan yang<br />sering diajukan</h2>
              </div>

              {/* Right accordion list */}
              <div className="kudos-faq-list">
                {FAQ_ITEMS.map((item, i) => (
                  <div
                    key={i}
                    className={`kudos-faq-item ${openFaq === i ? 'open' : ''}`}
                  >
                    <button
                      className="kudos-faq-question"
                      onClick={() => toggleFaq(i)}
                      aria-expanded={openFaq === i}
                    >
                      <span>{item.q}</span>
                      <ChevronDown className="kudos-faq-chevron" size={18} />
                    </button>
                    <div className="kudos-faq-answer">
                      <p>{item.a}</p>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </section>

        {/* ====================================================================
           SECTION 7: PRE-FOOTER CTA
           ==================================================================== */}
        <section id="cta" className="kudos-cta-section">
          <div className="wrap kudos-cta-inner">
            <h2 className="kudos-cta-heading">Upgrade stream kamu<br />ke level berikutnya</h2>
            <p className="kudos-cta-sub">
              Kontrol OBS Studio Mode, pasang 14+ widget interaktif, dan berikan pengalaman visual terbaik untuk penontonmu hari ini.
            </p>
            <div className="kudos-cta-actions">
              <Link href={isLoggedIn ? "/dashboard" : "/login"} className="kudos-cta-btn-primary">
                {isLoggedIn ? "Buka Dashboard" : "Mulai Gratis Sekarang"} <ArrowRight size={16} />
              </Link>
              <a href="#inside" className="kudos-cta-btn-ghost">
                Pelajari Fitur
              </a>
            </div>
            <p className="kudos-cta-reviews">Digunakan oleh 500+ streamer aktif di berbagai platform streaming.</p>
          </div>
        </section>
      </main>

      {/* ====================================================================
         FOOTER
         ==================================================================== */}
      <footer className="kudos-footer">
        <div className="wrap">
          {/* Top: Logo + Social */}
          <div className="kudos-footer-top">
            <div className="kudos-footer-brand">
              <span className="kudos-footer-logo">OBS Dock</span>
              <span className="kudos-footer-follow">Ikuti Kami</span>
              <div className="kudos-footer-socials">
                <a href="#" className="kudos-social-btn" aria-label="TikTok">
                  <Music2 size={16} />
                </a>
                <a href="#" className="kudos-social-btn" aria-label="Twitter / X">
                  <XIcon size={16} />
                </a>
                <a href="#" className="kudos-social-btn" aria-label="Instagram">
                  <Camera size={16} />
                </a>
              </div>
            </div>
          </div>

          {/* Divider */}
          <hr className="kudos-footer-divider" />

          {/* Footer columns */}
          <div className="kudos-footer-cols">
            <div className="kudos-footer-col">
              <h4 className="kudos-footer-col-title">OBS Dock</h4>
              <ul className="kudos-footer-links">
                <li><Link href="/">Home</Link></li>
                <li><Link href={isLoggedIn ? "/dashboard" : "/login"}>Dashboard</Link></li>
                <li><a href="#inside">Fitur & Tools</a></li>
                <li><a href="#faq">FAQ</a></li>
                <li><a href="#spotlight">Komunitas</a></li>
              </ul>
            </div>

            <div className="kudos-footer-col">
              <h4 className="kudos-footer-col-title">Fitur Unggulan</h4>
              <ul className="kudos-footer-links">
                <li><a href="#inside">OBS Dock Control</a></li>
                <li><a href="#inside">14+ Interactive Widgets</a></li>
                <li><a href="#inside">Real-time Stream Overlays</a></li>
                <li><a href="#inside">Media Player with Synced Lyrics</a></li>
                <li><a href="#inside">Mobile Dock Controller</a></li>
                <li><a href="#inside">Private Key Isolation</a></li>
              </ul>
            </div>

            <div className="kudos-footer-col">
              <h4 className="kudos-footer-col-title">Widgets & Tools</h4>
              <ul className="kudos-footer-links">
                <li><a href="#inside">Live Chat Widget</a></li>
                <li><a href="#inside">Viewer Poll & Vote</a></li>
                <li><a href="#inside">Sub & Follow Goals</a></li>
                <li><a href="#inside">Stream Countdown Timer</a></li>
                <li><a href="#inside">Social Media Rotator</a></li>
                <li><a href="#inside">Real-time View Counter</a></li>
              </ul>
            </div>

            <div className="kudos-footer-col">
              <h4 className="kudos-footer-col-title">Platform & Bantuan</h4>
              <ul className="kudos-footer-links">
                <li><a href="#inside">OBS Studio (v28+)</a></li>
                <li><a href="#inside">Streamlabs Desktop</a></li>
                <li><a href="#inside">Twitch & YouTube Live</a></li>
                <li><a href="#inside">TikTok LIVE Studio</a></li>
                <li><a href="#faq">Panduan Browser Source</a></li>
                <li><a href="#faq">Bantuan & Dokumentasi</a></li>
              </ul>
            </div>
          </div>

          {/* Footer bottom bar */}
          <hr className="kudos-footer-divider" />
          <div className="kudos-footer-bottom">
            <p className="kudos-footer-copy">
              © 2026, OBS Dock. All rights reserved.&nbsp;&nbsp;
              <a href="#">Syarat & Ketentuan</a>&nbsp;&nbsp;
              <a href="#">Kebijakan Privasi</a>&nbsp;&nbsp;
              <a href="#">Dokumentasi</a>&nbsp;&nbsp;
              <a href="#">Hubungi Kami</a>
            </p>
            <div className="kudos-payment-badges">
              <span className="kudos-pay-badge">OBS Studio</span>
              <span className="kudos-pay-badge">Twitch</span>
              <span className="kudos-pay-badge">YouTube</span>
              <span className="kudos-pay-badge">TikTok Live</span>
              <span className="kudos-pay-badge">Streamlabs</span>
              <span className="kudos-pay-badge">WebSocket</span>
            </div>
          </div>
        </div>
      </footer>

      {/* ====================================================================
         FLOATING BLUE CHAT BUBBLE BUTTON (Exact match to Kudos bottom right)
         ==================================================================== */}
      <button
        className="kudos-floating-chat"
        onClick={() => showToast('Customer support chat live siap membantu!')}
        aria-label="Live Chat Support"
        title="Need help? Chat with us"
      >
        <MessageCircle size={24} />
      </button>

      {/* Toast Notification Bar */}
      <div className={`kudos-toast ${toastText ? 'show' : ''}`}>
        {toastText}
      </div>
    </div>
  );
}

