                  <div style={{ width: '42%', height: 42, background: '#0284c7', borderRadius: 10 }} />
                  {/* Avatar circle */}
                  <div style={{ width: 52, height: 52, borderRadius: '50%', background: '#ffffff', border: '3px solid #38bdf8', display: 'flex', alignItems: 'center', justifyContent: 'center' }}>
                    <div style={{ width: 26, height: 26, borderRadius: '50%', background: '#94a3b8' }} />
                  </div>
                  {/* Badge Swatches */}
                  <div style={{ display: 'flex', flexDirection: 'column', gap: 6 }}>
                    <div style={{ width: 32, height: 14, background: '#84cc16', borderRadius: 4 }} />
                    <div style={{ width: 32, height: 14, background: '#ef4444', borderRadius: 4 }} />
                    <div style={{ width: 32, height: 14, background: '#0084ff', borderRadius: 4 }} />
