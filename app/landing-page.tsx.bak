                <div className="kudos-inside-visual tint-green">
                  <div style={{ width: '70%', height: 110, background: '#ffffff', borderRadius: 14, border: '1px solid #bbf7d0', display: 'flex', alignItems: 'center', justifyContent: 'center', gap: 14, padding: 16 }}>
                    <div style={{ width: 54, height: 54, borderRadius: '50%', border: '3px solid #16a34a', display: 'flex', alignItems: 'center', justifyContent: 'center' }}>
                      <div style={{ width: 18, height: 18, borderRadius: '50%', background: '#86efac' }} />
