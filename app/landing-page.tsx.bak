                <span className="kudos-dropdown-icon" style={{ background: '#f1f5f9', borderColor: '#e2e8f0' }}><Sliders size={16} color="#334155" /></span>
                <span><strong>Widget Dashboard</strong><span>Kelola semua widget</span></span>
