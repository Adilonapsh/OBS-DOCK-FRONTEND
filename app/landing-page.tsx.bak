              <div className="kudos-inside-card">
                <div className="kudos-inside-visual tint-purple">
                  <div style={{ width: '80%', height: 85, background: '#ffffff', borderRadius: 12, border: '1px solid #e9d5ff', boxShadow: '0 8px 20px rgba(168, 85, 247, 0.1)', display: 'flex', flexDirection: 'column', alignItems: 'center', justifyContent: 'center', gap: 8 }}>
                    <span style={{ width: '45%', height: 8, background: '#a855f7', borderRadius: 4 }} />
                    <span style={{ width: '20%', height: 4, background: '#c084fc', borderRadius: 2 }} />
                  </div>
