        <section id="reviews" className="kudos-reviews-section">
          <div className="wrap">
            <div className="kudos-reviews-header">
              <h2 className="kudos-reviews-title">Yang streamer bilang</h2>
              <p className="kudos-reviews-subhead">
                Review nyata dari para streamer yang sudah pakai OBS Dock setiap hari.
              </p>
            </div>

            {/* Masonry / Sticky Board */}
            <div className="kudos-sticky-board">
              <div className="kudos-sticky-grid">
                {STICKY_REVIEWS.map((r) => (
                  <div key={r.id} className={`kudos-sticky-note ${r.tint}`}>
                    <div>
                      <div className="kudos-note-stars">
                        {'★'.repeat(r.stars)}
                      </div>
                      <div className="kudos-note-quote">
                        "{r.quote}"
                      </div>
                    </div>
                    <div className="kudos-note-footer">
                      <span className="kudos-note-author">{r.author}</span> · {r.product}
                    </div>
                  </div>
                ))}
              </div>

              {/* Navigation arrows at bottom right */}
              <div className="kudos-sticky-nav">
                <button
                  className="kudos-sticky-nav-btn"
                  onClick={() => showToast('Halaman ulasan sebelumnya')}
                  aria-label="Previous Reviews"
                >
                  <ChevronLeft size={16} />
                </button>
                <button
                  className="kudos-sticky-nav-btn"
                  onClick={() => showToast('Halaman ulasan berikutnya')}
                  aria-label="Next Reviews"
                >
                  <ChevronRight size={16} />
                </button>
              </div>
            </div>
